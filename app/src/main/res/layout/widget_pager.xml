<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="NestedWeights,UseCompoundDrawables,ContentDescription">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <!-- 1-row widgets: ‹ label •∘∘  value (−1) (+1) › -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageView
            android:id="@+id/pager_prev"
            android:layout_width="28dp"
            android:layout_height="40dp"
            android:paddingVertical="8dp"
            android:src="@drawable/ic_chevron_left" />

        <LinearLayout
            android:id="@+id/pager_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pager_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="horizontal">
                <ImageView
                    android:id="@+id/pager_dot0"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="0dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot" />
                <ImageView
                    android:id="@+id/pager_dot1"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot" />
                <ImageView
                    android:id="@+id/pager_dot2"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot" />
                <ImageView
                    android:id="@+id/pager_dot3"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/pager_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/pager_minus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp">

            <ImageView
                android:id="@+id/pager_minus_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_circle" />

            <TextView
                android:id="@+id/pager_minus_label"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="−1"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/pager_plus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp">

            <ImageView
                android:id="@+id/pager_plus_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_circle" />

            <TextView
                android:id="@+id/pager_plus_label"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="+1"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />
        </FrameLayout>

        <ImageView
            android:id="@+id/pager_next"
            android:layout_width="28dp"
            android:layout_height="40dp"
            android:paddingVertical="8dp"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>
</FrameLayout>
