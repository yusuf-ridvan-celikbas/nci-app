<?xml version="1.0" encoding="utf-8"?>
<!-- 1×2 and other skinny 2-row widgets: the 2×2 pages look, narrowed. Same ids as widget_small. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="NestedWeights,ContentDescription">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="2dp"
        android:paddingVertical="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_prev"
                android:layout_width="22dp"
                android:layout_height="28dp"
                android:paddingVertical="5dp"
                android:src="@drawable/ic_chevron_left" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_page_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_dot0"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_dot" />

                    <ImageView
                        android:id="@+id/widget_dot1"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="3dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_dot" />

                    <ImageView
                        android:id="@+id/widget_dot2"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="3dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_dot" />

                    <ImageView
                        android:id="@+id/widget_dot3"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="3dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_dot" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="22dp"
                android:layout_height="28dp"
                android:paddingVertical="5dp"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_value"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_minus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp">

                <ImageView
                    android:id="@+id/widget_minus_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_circle" />

                <TextView
                    android:id="@+id/widget_minus_label"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:text="−1"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />
            </FrameLayout>

            <include
                layout="@layout/widget_add_button"
                android:layout_width="36dp"
                android:layout_height="36dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
